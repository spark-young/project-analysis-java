# ============================================================================
#  换行符策略：由仓库统一约束，不依赖各人本机的 core.autocrlf
# ============================================================================

# 1) 文本文件入库统一存 LF（git 自动跳过二进制文件）
* text=auto

# 2) 例外：启动脚本必须是各自平台的原生换行
#    .bat → CRLF（cmd.exe 对 LF 的容错不稳定，尤其含标签 / goto 时）
#    .sh  → LF（CRLF 会让 Linux / macOS 上的 bash 报 $'\r': command not found）
*.bat text eol=crlf
*.sh  text eol=lf
